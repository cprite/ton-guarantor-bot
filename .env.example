# ---------------------------------------------------------------- Telegram --
# Token from @BotFather. Treat it like a password: anyone holding it controls
# the bot and can read every message sent to it.
BOT_TOKEN=

# Telegram user IDs allowed to arbitrate disputes and move funds by hand.
# Comma-separated. Ask @userinfobot for yours. Leaving this empty is refused
# at start-up: a disputed deal would have nobody to resolve it.
ADMIN_IDS=

# Fallback UI language (en or ru). Users can switch with /lang.
DEFAULT_LOCALE=en

# --------------------------------------------------------------------- TON --
# Start on testnet. Move to mainnet only after a full rehearsal.
TON_NETWORK=testnet

# toncenter or tonapi.
TON_PROVIDER=toncenter
# Strongly recommended: without a key the public endpoints rate-limit hard
# enough that deposits are noticed late. toncenter.com/api or tonconsole.com.
TON_API_KEY=
# Point at your own indexer if you run one.
# TON_API_BASE_URL=

# ------------------------------------------------------------------ Escrow --
# Seed phrase of the hot wallet that holds deposits between the two legs of a
# deal. Generate one with `guarantor new-wallet`. Whoever has this phrase has
# every deposit the bot is holding: keep it in a secret manager, not in git.
ESCROW_MNEMONIC=

# v4r2 (4 messages per transaction) or v5r1 (255).
ESCROW_WALLET_VERSION=v4r2

# TON kept aside to pay for forwarding NFTs and jettons. Payouts are refused
# rather than half-completed when the balance would drop below this.
ESCROW_MIN_RESERVE_TON=0.5

# -------------------------------------------------------------------- Fees --
FEE_PERCENT=1.0
FEE_MIN_TON=0.05
# Fee for deals with no TON leg, when FEE_NO_TON_LEG=require_deposit.
FEE_FLAT_TON=0.1
# receiver: deducted from the payout. sender: added to the deposit.
# split: half each.
FEE_PAYER=receiver
# skip: NFT-for-NFT style deals are free. require_deposit: each side sends the
# fee as a separate small TON transfer.
FEE_NO_TON_LEG=skip
# Where fees are swept after each deal. Empty means they stay in the escrow.
# FEE_WALLET=

# ------------------------------------------------------------ Gas and dust --
NFT_PAYOUT_GAS_TON=0.05
JETTON_PAYOUT_GAS_TON=0.05
MIN_DEPOSIT_TON=0.01

# ------------------------------------------------------------------ Timing --
# How long a deal waits for somebody to join.
OPEN_DEAL_TTL_SECONDS=86400
# How long both sides have to fund an accepted deal before it is refunded.
DEPOSIT_TIMEOUT_SECONDS=3600
POLL_INTERVAL_SECONDS=8
SWEEP_INTERVAL_SECONDS=60

# ------------------------------------------------------------------ Policy --
# Allow a leg the chain cannot verify ("I'll send you the account details").
# Such deals can only be resolved by the parties agreeing or by arbitration.
ALLOW_OFFCHAIN_ASSETS=true
MAX_ACTIVE_DEALS_PER_USER=10
RATE_LIMIT_PER_SECOND=3

# ----------------------------------------------------------------- Runtime --
DATABASE_PATH=data/guarantor.db
LOG_LEVEL=INFO
